        {
          "h": "Indirekte Rede",
          "p": "Reports what was said, often using Konjunktiv I.",
          "ex": "Sie sagte, sie sei müde.",
          "audioId": "unit13-ex2"
        },
        {
          "h": "Konjunktiv I forms",
          "p": "A special verb mood mainly used in reported speech, especially in writing/news.",
