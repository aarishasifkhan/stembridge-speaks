{
  "units": [
    {
      "id": "nouns-gender-articles",
      "title": "Nouns, Gender & Articles",
      "icon": "📘",
      "teaching": [
        {
          "h": "Every noun has a gender",
          "p": "German nouns are masculine (der), feminine (die), or neuter (das).",
          "ex": "der Mann · die Frau · das Kind",
          "audioId": "unit1-ex1"
        },
        {
          "h": "Definite articles (nominative)",
          "p": "In the subject position, use der/die/das depending on gender.",
          "ex": "Der Mann ist hier.",
          "audioId": "unit1-ex2"
        },
        {
          "h": "Indefinite articles",
          "p": "Ein for masculine and neuter, eine for feminine.",
          "ex": "ein Mann · eine Frau · ein Kind",
          "audioId": "unit1-ex3"
        },
        {
          "h": "Plurals",
          "p": "All genders use die in the nominative plural.",
          "ex": "der Mann → die Männer",
          "audioId": "unit1-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Which article goes with Buch (neuter)?",
          "options": ["der", "die", "das"],
          "answer": "das",
          "audioId": "unit1-q1"
        },
        {
          "type": "fill",
          "q": "___ Frau ist hier.",
          "answer": "die",
          "audioId": "unit1-q2"
        },
        {
          "type": "mc",
          "q": "Nominative plural article for all genders?",
          "options": ["der", "die", "das"],
          "answer": "die",
          "audioId": "unit1-q3"
        },
        {
          "type": "mc",
          "q": "Indefinite article for masculine?",
          "options": ["ein", "eine", "einen"],
          "answer": "ein",
          "audioId": "unit1-q4"
        },
        {
          "type": "fill",
          "q": "Das ist ___ Mädchen.",
          "answer": "ein",
          "audioId": "unit1-q5"
        }
      ]
    },
    {
      "id": "pronouns-present-tense",
      "title": "Pronouns & Present Tense",
      "icon": "🗣️",
      "teaching": [
        {
          "h": "Personal pronouns",
          "p": "ich, du, er/sie/es, wir, ihr, sie/Sie.",
          "ex": "ich, du, er, sie, es, wir, ihr, sie",
          "exTranslation": "I, you (informal), he, she, it, we, you (plural), they",
          "audioId": "unit2-ex1"
        },
        {
          "h": "Regular verb conjugation",
          "p": "Drop -en and add the right ending.",
          "ex": "machen → ich mache, du machst, er macht, wir machen, ihr macht, sie machen",
          "exTranslation": "to do/make → I do, you do, he does, we do, you (plural) do, they do",
          "audioId": "unit2-ex2"
        },
        {
          "h": "sein (to be)",
          "p": "Common irregular verb.",
          "ex": "ich bin, du bist, er ist, wir sind, ihr seid, sie sind",
          "exTranslation": "I am, you are, he is, we are, you (plural) are, they are",
          "audioId": "unit2-ex3"
        },
        {
          "h": "Formal you",
          "p": "Sie is the formal you.",
          "ex": "Sprechen Sie Deutsch?",
          "exTranslation": "Do you speak German? (formal)",
          "audioId": "unit2-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Who does du refer to?",
          "options": ["I", "you informal", "we"],
          "answer": "you informal",
          "audioId": "unit2-q1"
        },
        {
          "type": "fill",
          "q": "Ich ___ Deutsch. (machen)",
          "answer": "mache",
          "audioId": "unit2-q2"
        },
        {
          "type": "fill",
          "q": "Er ___ das. (machen)",
          "answer": "macht",
          "audioId": "unit2-q3"
        },
        {
          "type": "mc",
          "q": "sein form for wir?",
          "options": ["bin", "ist", "sind"],
          "answer": "sind",
          "audioId": "unit2-q4"
        },
        {
          "type": "mc",
          "q": "Formal you pronoun?",
          "options": ["du", "ihr", "Sie"],
          "answer": "Sie",
          "audioId": "unit2-q5"
        }
      ]
    },
    {
      "id": "cases-intro",
      "title": "Cases: Nominative, Accusative, Dative",
      "icon": "🧩",
      "teaching": [
        {
          "h": "What is case?",
          "p": "Articles change based on a noun's grammatical role.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Nominative",
          "p": "The subject.",
          "ex": "Der Mann sieht den Hund.",
          "audioId": "unit3-ex1"
        },
        {
          "h": "Accusative",
          "p": "Only masculine changes: der → den.",
          "ex": "Ich sehe den Mann.",
          "audioId": "unit3-ex2"
        },
        {
          "h": "Dative",
          "p": "der→dem, die→der, das→dem.",
          "ex": "Ich gebe der Frau das Buch.",
          "audioId": "unit3-ex3"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Masculine der in accusative?",
          "options": ["den", "dem", "der"],
          "answer": "den",
          "audioId": "unit3-q1"
        },
        {
          "type": "fill",
          "q": "Ich sehe ___ Mann.",
          "answer": "den",
          "audioId": "unit3-q2"
        },
        {
          "type": "mc",
          "q": "Subject case?",
          "options": ["nominative", "accusative", "dative"],
          "answer": "nominative",
          "audioId": "unit3-q3"
        },
        {
          "type": "fill",
          "q": "Ich gebe ___ Frau das Buch.",
          "answer": "der",
          "audioId": "unit3-q4"
        },
        {
          "type": "mc",
          "q": "Feminine articles change in accusative?",
          "options": ["Yes", "No"],
          "answer": "No",
          "audioId": "unit3-q5"
        }
      ]
    },
    {
      "id": "word-order",
      "title": "Word Order",
      "icon": "🔀",
      "teaching": [
        {
          "h": "Verb-second rule",
          "p": "Verb is always the second element.",
          "ex": "Heute gehe ich ins Kino.",
          "audioId": "unit4-ex1"
        },
        {
          "h": "Subordinate clauses",
          "p": "Verb moves to the end after weil/dass/wenn.",
          "ex": "Ich bleibe zuhause, weil ich krank bin.",
          "audioId": "unit4-ex2"
        },
        {
          "h": "Yes/no questions",
          "p": "Verb moves first.",
          "ex": "Gehst du ins Kino?",
          "audioId": "unit4-ex3"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Verb position in main clause?",
          "options": ["1st", "2nd", "last"],
          "answer": "2nd",
          "audioId": "unit4-q1"
        },
        {
          "type": "fill",
          "q": "Heute ___ ich ins Kino. (gehen)",
          "answer": "gehe",
          "audioId": "unit4-q2"
        },
        {
          "type": "mc",
          "q": "Verb position after weil?",
          "options": ["2nd", "end"],
          "answer": "end",
          "audioId": "unit4-q3"
        },
        {
          "type": "fill",
          "q": "Ich bleibe zuhause, weil ich krank ___. (sein)",
          "answer": "bin",
          "audioId": "unit4-q4"
        },
        {
          "type": "mc",
          "q": "Yes/no question verb position?",
          "options": ["first", "second", "last"],
          "answer": "first",
          "audioId": "unit4-q5"
        }
      ]
    },
    {
      "id": "modal-verbs",
      "title": "Modal Verbs",
      "icon": "⚙️",
      "teaching": [
        {
          "h": "What modals do",
          "p": "Express ability, necessity, desire, permission.",
          "ex": "",
          "exTranslation": "",
          "audioId": ""
        },
        {
          "h": "Sentence structure",
          "p": "Modal in position 2, main verb infinitive at the end.",
          "ex": "Ich kann gut Deutsch sprechen.",
          "exTranslation": "I can speak German well.",
          "audioId": "unit5-ex1"
        },
        {
          "h": "können conjugation",
          "p": "Note: ich and er/sie/es share the same form.",
          "ex": "ich kann, du kannst, er kann, wir können, ihr könnt, sie können",
          "exTranslation": "I can, you can, he can, we can, you (plural) can, they can",
          "audioId": "unit5-ex2"
        },
        {
          "h": "Common modals",
          "p": "müssen=must, wollen=want, dürfen=allowed.",
          "ex": "",
          "exTranslation": "",
          "audioId": ""
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Position of sprechen in the sentence?",
          "options": ["2nd", "end"],
          "answer": "end",
          "audioId": "unit5-q1"
        },
        {
          "type": "fill",
          "q": "Ich ___ gut Deutsch sprechen. (können)",
          "answer": "kann",
          "audioId": "unit5-q2"
        },
        {
          "type": "mc",
          "q": "müssen expresses?",
          "options": ["ability", "necessity", "desire"],
          "answer": "necessity",
          "audioId": "unit5-q3"
        },
        {
          "type": "fill",
          "q": "Du ___ das nicht machen. (dürfen)",
          "answer": "darfst",
          "audioId": "unit5-q4"
        },
        {
          "type": "mc",
          "q": "wollen means?",
          "options": ["can", "must", "want to"],
          "answer": "want to",
          "audioId": "unit5-q5"
        }
      ]
    },
    {
      "id": "parts-of-speech",
      "title": "Parts of Speech (Wortarten)",
      "icon": "🧱",
      "teaching": [
        {
          "h": "The main word classes",
          "p": "German words fall into categories: Nomen (noun), Verb, Adjektiv, Adverb, Pronomen, Präposition, Konjunktion.",
          "ex": "laufen (Verb), schnell (Adverb), Lehrer (Nomen)",
          "audioId": "unit6-ex1"
        },
        {
          "h": "Nomen are always capitalized",
          "p": "Unlike English, every German noun is capitalized, no matter where it appears in the sentence.",
          "ex": "Der Tisch ist groß. Ich sehe den Tisch.",
          "audioId": "unit6-ex2"
        },
        {
          "h": "Adjektive describe nouns",
          "p": "Adjectives often take an ending that matches the noun's gender and case.",
          "ex": "der große Tisch",
          "audioId": "unit6-ex3"
        },
        {
          "h": "Präpositionen and Konjunktionen",
          "p": "Prepositions show relationships (in, auf, unter). Conjunctions connect ideas (und, aber, weil).",
          "ex": "Die Katze sitzt auf dem Tisch, aber sie schläft.",
          "audioId": "unit6-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "In \"Sie läuft schnell,\" what part of speech is \"schnell\"?",
          "options": ["Nomen", "Verb", "Adverb"],
          "answer": "Adverb",
          "audioId": "unit6-q1"
        },
        {
          "type": "mc",
          "q": "In German, which word class is always capitalized?",
          "options": ["Verben", "Nomen", "Adjektive"],
          "answer": "Nomen",
          "audioId": "unit6-q2"
        },
        {
          "type": "fill",
          "q": "der ___ Tisch (adjective for \"big\", with ending)",
          "answer": "große",
          "audioId": "unit6-q3"
        },
        {
          "type": "mc",
          "q": "\"auf\" is an example of a:",
          "options": ["Präposition", "Konjunktion", "Adverb"],
          "answer": "Präposition",
          "audioId": "unit6-q4"
        },
        {
          "type": "mc",
          "q": "\"aber\" connects two ideas — it is a:",
          "options": ["Konjunktion", "Präposition"],
          "answer": "Konjunktion",
          "audioId": "unit6-q5"
        }
      ]
    },
    {
      "id": "sentence-types",
      "title": "Sentence Types (Satzarten)",
      "icon": "🏗️",
      "teaching": [
        {
          "h": "Aussagesatz (statement)",
          "p": "A simple declarative sentence, verb in position 2.",
          "ex": "Ich gehe nach Hause.",
          "audioId": "unit7-ex1"
        },
        {
          "h": "Fragesatz (question)",
          "p": "Verb-first (yes/no) or a question word first (W-question).",
          "ex": "Gehst du nach Hause? Wohin gehst du?",
          "audioId": "unit7-ex2"
        },
        {
          "h": "Satzreihe (compound sentence)",
          "p": "Two independent clauses joined by und, aber, oder, denn — both keep verb-second order.",
          "ex": "Ich koche, und du deckst den Tisch.",
          "audioId": "unit7-ex3"
        },
        {
          "h": "Satzgefüge (complex sentence)",
          "p": "A main clause plus a subordinate clause, where the subordinate clause's verb goes to the end.",
          "ex": "Ich bleibe zuhause, weil es regnet.",
          "audioId": "unit7-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"Ich gehe nach Hause.\" is an example of a(n):",
          "options": ["Aussagesatz", "Fragesatz"],
          "answer": "Aussagesatz",
          "audioId": "unit7-q1"
        },
        {
          "type": "mc",
          "q": "In a Satzreihe, both clauses keep:",
          "options": ["verb-second order", "verb-final order"],
          "answer": "verb-second order",
          "audioId": "unit7-q2"
        },
        {
          "type": "mc",
          "q": "\"Ich bleibe zuhause, weil es regnet.\" is a:",
          "options": ["Satzreihe", "Satzgefüge"],
          "answer": "Satzgefüge",
          "audioId": "unit7-q3"
        },
        {
          "type": "fill",
          "q": "Ich koche, ___ du deckst den Tisch. (and)",
          "answer": "und",
          "audioId": "unit7-q4"
        },
        {
          "type": "mc",
          "q": "A W-question starts with:",
          "options": ["a question word", "the verb"],
          "answer": "a question word",
          "audioId": "unit7-q5"
        }
      ]
    },
    {
      "id": "separable-verbs",
      "title": "Separable and Inseparable Verbs",
      "icon": "🤝",
      "teaching": [
        {
          "h": "Separable verbs",
          "p": "A prefix detaches and moves to the end of the sentence in the present/simple past.",
          "ex": "anrufen → Ich rufe dich an.",
          "audioId": "unit8-ex1"
        },
        {
          "h": "Common separable prefixes",
          "p": "auf-, an-, ab-, mit-, aus- often separate.",
          "ex": "aufstehen → Ich stehe um sieben Uhr auf.",
          "audioId": "unit8-ex2"
        },
        {
          "h": "Inseparable verbs",
          "p": "Prefixes like be-, ge-, ver-, ent- never separate from the verb.",
          "ex": "verstehen → Ich verstehe das.",
          "audioId": "unit8-ex3"
        },
        {
          "h": "In subordinate clauses",
          "p": "Separable verbs reunite at the end when the whole verb moves there.",
          "ex": "..., weil ich dich anrufe.",
          "audioId": "unit8-ex4"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "Ich rufe dich ___. (anrufen, separated)",
          "answer": "an",
          "audioId": "unit8-q1"
        },
        {
          "type": "mc",
          "q": "Which prefix is typically inseparable?",
          "options": ["auf-", "ver-", "mit-"],
          "answer": "ver-",
          "audioId": "unit8-q2"
        },
        {
          "type": "fill",
          "q": "Ich ___ um sieben Uhr auf. (aufstehen)",
          "answer": "stehe",
          "audioId": "unit8-q3"
        },
        {
          "type": "mc",
          "q": "\"verstehen\" is:",
          "options": ["separable", "inseparable"],
          "answer": "inseparable",
          "audioId": "unit8-q4"
        },
        {
          "type": "mc",
          "q": "In a subordinate clause, a separable verb's parts:",
          "options": ["stay split", "reunite at the end"],
          "answer": "reunite at the end",
          "audioId": "unit8-q5"
        }
      ]
    },
    {
      "id": "tenses-full-system",
      "title": "Tenses (The Full System)",
      "icon": "⏱️",
      "teaching": [
        {
          "h": "Präsens (present)",
          "p": "Used for now and often for the near future too.",
          "ex": "Ich arbeite heute.",
          "audioId": "unit9-ex1"
        },
        {
          "h": "Perfekt (conversational past)",
          "p": "haben/sein + past participle — the most common past tense in speech.",
          "ex": "Ich habe gearbeitet. Ich bin gegangen.",
          "audioId": "unit9-ex2"
        },
        {
          "h": "Präteritum (narrative past)",
          "p": "A single past-tense verb form, common in writing and with sein/haben/modals even in speech.",
          "ex": "Ich arbeitete. Ich war müde.",
          "audioId": "unit9-ex3"
        },
        {
          "h": "Futur I",
          "p": "werden + infinitive, for future actions.",
          "ex": "Ich werde morgen arbeiten.",
          "audioId": "unit9-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "The most common past tense in spoken German is:",
          "options": ["Perfekt", "Präteritum"],
          "answer": "Perfekt",
          "audioId": "unit9-q1"
        },
        {
          "type": "fill",
          "q": "Ich ___ gearbeitet. (haben, Perfekt)",
          "answer": "habe",
          "audioId": "unit9-q2"
        },
        {
          "type": "mc",
          "q": "Futur I is formed with:",
          "options": ["werden + infinitive", "haben + participle"],
          "answer": "werden + infinitive",
          "audioId": "unit9-q3"
        },
        {
          "type": "fill",
          "q": "Ich ___ morgen arbeiten. (werden, Futur I)",
          "answer": "werde",
          "audioId": "unit9-q4"
        },
        {
          "type": "mc",
          "q": "\"Ich war müde\" uses which tense?",
          "options": ["Präteritum", "Perfekt"],
          "answer": "Präteritum",
          "audioId": "unit9-q5"
        }
      ]
    },
    {
      "id": "conditional-sentences",
      "title": "Conditional Sentences (Konjunktiv II)",
      "icon": "🔀",
      "teaching": [
        {
          "h": "Real conditions",
          "p": "wenn + present tense, present or future — for realistic situations.",
          "ex": "Wenn es regnet, bleibe ich zuhause.",
          "audioId": "unit10-ex1"
        },
        {
          "h": "Konjunktiv II — hypothetical",
          "p": "Used for unreal or hypothetical situations, often with würde + infinitive.",
          "ex": "Wenn ich reich wäre, würde ich reisen.",
          "audioId": "unit10-ex2"
        },
        {
          "h": "wäre and hätte",
          "p": "The Konjunktiv II forms of sein and haben are irregular and very common.",
          "ex": "ich wäre (I would be), ich hätte (I would have)",
          "audioId": "unit10-ex3"
        },
        {
          "h": "Past hypotheticals",
          "p": "hätte/wäre + past participle, for imagined past outcomes.",
          "ex": "Wenn ich Zeit gehabt hätte, wäre ich gekommen.",
          "audioId": "unit10-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"Wenn es regnet, bleibe ich zuhause.\" describes:",
          "options": ["a realistic condition", "an unreal hypothetical"],
          "answer": "a realistic condition",
          "audioId": "unit10-q1"
        },
        {
          "type": "fill",
          "q": "Wenn ich reich ___, würde ich reisen. (sein, Konjunktiv II)",
          "answer": "wäre",
          "audioId": "unit10-q2"
        },
        {
          "type": "mc",
          "q": "würde + infinitive is used for:",
          "options": ["hypothetical situations", "simple facts"],
          "answer": "hypothetical situations",
          "audioId": "unit10-q3"
        },
        {
          "type": "fill",
          "q": "ich ___ (Konjunktiv II of haben)",
          "answer": "hätte",
          "audioId": "unit10-q4"
        },
        {
          "type": "mc",
          "q": "Past hypotheticals use:",
          "options": ["hätte/wäre + past participle", "werden + infinitive"],
          "answer": "hätte/wäre + past participle",
          "audioId": "unit10-q5"
        }
      ]
    },
    {
      "id": "phrases-clauses",
      "title": "Satzglieder und Nebensätze",
      "icon": "🧩",
      "teaching": [
        {
          "h": "Satzglied (sentence element)",
          "p": "A group of words functioning as one unit within the sentence — subject, object, adverbial.",
          "ex": "Der alte Mann (subject) liest ein Buch.",
          "audioId": "unit11-ex1"
        },
        {
          "h": "Hauptsatz (main clause)",
          "p": "Can stand alone; verb in position 2.",
          "ex": "Ich lese ein Buch.",
          "audioId": "unit11-ex2"
        },
        {
          "h": "Nebensatz (subordinate clause)",
          "p": "Cannot stand alone; verb moves to the end.",
          "ex": "..., weil ich ein Buch lese.",
          "answer_hint": "",
          "audioId": "unit11-ex3"
        },
        {
          "h": "Relativsatz (relative clause)",
          "p": "Adds extra information about a noun using der/die/das as relative pronouns.",
          "ex": "Der Mann, der dort steht, ist mein Lehrer.",
          "audioId": "unit11-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"Ich lese ein Buch.\" is a:",
          "options": ["Hauptsatz", "Nebensatz"],
          "answer": "Hauptsatz",
          "audioId": "unit11-q1"
        },
        {
          "type": "mc",
          "q": "In a Nebensatz, the verb goes:",
          "options": ["second", "at the end"],
          "answer": "at the end",
          "audioId": "unit11-q2"
        },
        {
          "type": "fill",
          "q": "Der Mann, ___ dort steht, ist mein Lehrer. (relative pronoun)",
          "answer": "der",
          "audioId": "unit11-q3"
        },
        {
          "type": "mc",
          "q": "A Nebensatz can stand alone as a full sentence:",
          "options": ["true", "false"],
          "answer": "false",
          "audioId": "unit11-q4"
        },
        {
          "type": "mc",
          "q": "A Relativsatz gives extra information about a:",
          "options": ["noun", "verb"],
          "answer": "noun",
          "audioId": "unit11-q5"
        }
      ]
    },
    {
      "id": "active-passive-voice",
      "title": "Aktiv und Passiv",
      "icon": "🔄",
      "teaching": [
        {
          "h": "Aktiv (active)",
          "p": "The subject performs the action.",
          "ex": "Der Koch kocht das Essen.",
          "audioId": "unit12-ex1"
        },
        {
          "h": "Passiv (passive)",
          "p": "werden + past participle — the subject receives the action.",
