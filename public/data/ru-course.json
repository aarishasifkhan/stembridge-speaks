{
  "units": [
    {
      "id": "gender-noun-basics",
      "title": "Gender & Noun Basics",
      "icon": "📘",
      "teaching": [
        {
          "h": "Three genders",
          "p": "Russian nouns are masculine, feminine, or neuter, usually predictable from the ending.",
          "ex": "стол (m), книга (f), окно (n)",
          "audioId": "unit1-ex1"
        },
        {
          "h": "Masculine endings",
          "p": "Usually end in a consonant.",
          "ex": "стол, дом",
          "audioId": "unit1-ex2"
        },
        {
          "h": "Feminine endings",
          "p": "Usually end in -а or -я.",
          "ex": "книга, земля",
          "audioId": "unit1-ex3"
        },
        {
          "h": "Neuter endings",
          "p": "Usually end in -о or -е.",
          "ex": "окно, море",
          "audioId": "unit1-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Nouns ending in a consonant are usually:",
          "options": ["masculine", "feminine", "neuter"],
          "answer": "masculine",
          "audioId": "unit1-q1"
        },
        {
          "type": "mc",
          "q": "Which gender is книга (book)?",
          "options": ["masculine", "feminine", "neuter"],
          "answer": "feminine",
          "audioId": "unit1-q2"
        },
        {
          "type": "mc",
          "q": "Which ending usually signals neuter gender?",
          "options": ["-о/-е", "-а/-я"],
          "answer": "-о/-е",
          "audioId": "unit1-q3"
        },
        {
          "type": "fill",
          "q": "окно ends in ___, showing neuter. (о)",
          "answer": "о",
          "audioId": "unit1-q4"
        },
        {
          "type": "mc",
          "q": "земля (land) is:",
          "options": ["masculine", "feminine", "neuter"],
          "answer": "feminine",
          "audioId": "unit1-q5"
        }
      ]
    },
    {
      "id": "six-cases",
      "title": "The Six Cases (Overview)",
      "icon": "🧩",
      "teaching": [
        {
          "h": "What cases do",
          "p": "Russian nouns/adjectives change form based on their grammatical role — six cases total.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Nominative",
          "p": "The subject, dictionary form.",
          "ex": "Это стол.",
          "audioId": "unit2-ex1"
        },
        {
          "h": "Accusative",
          "p": "The direct object.",
          "ex": "Я вижу стол.",
          "audioId": "unit2-ex2"
        },
        {
          "h": "Genitive, Dative, Instrumental, Prepositional",
          "p": "Show possession, indirect objects, means, and location/topic.",
          "ex": "",
          "audioId": ""
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "How many grammatical cases does Russian have?",
          "options": ["4", "6", "8"],
          "answer": "6",
          "audioId": "unit2-q1"
        },
        {
          "type": "mc",
          "q": "Which case is used for the subject?",
          "options": ["nominative", "accusative"],
          "answer": "nominative",
          "audioId": "unit2-q2"
        },
        {
          "type": "mc",
          "q": "Which case marks the direct object?",
          "options": ["nominative", "accusative"],
          "answer": "accusative",
          "audioId": "unit2-q3"
        },
        {
          "type": "mc",
          "q": "The genitive case commonly shows:",
          "options": ["possession", "location"],
          "answer": "possession",
          "audioId": "unit2-q4"
        },
        {
          "type": "mc",
          "q": "The prepositional case is typically used for:",
          "options": ["location/topic", "direct objects"],
          "answer": "location/topic",
          "audioId": "unit2-q5"
        }
      ]
    },
    {
      "id": "present-conjugation",
      "title": "Present-Tense Verb Conjugation",
      "icon": "🗣️",
      "teaching": [
        {
          "h": "Two conjugation groups",
          "p": "Russian verbs belong to Conjugation I or II, each with distinct present-tense endings.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Conjugation I example",
          "p": "читать → читаю, читаешь, читает, читаем, читаете, читают",
          "ex": "Я читаю книгу.",
          "audioId": "unit3-ex1"
        },
        {
          "h": "Conjugation II example",
          "p": "говорить → говорю, говоришь, говорит, говорим, говорите, говорят",
          "ex": "Он говорит по-русски.",
          "audioId": "unit3-ex2"
        },
        {
          "h": "No separate to be in the present",
          "p": "Russian usually omits to be in present-tense sentences entirely.",
          "ex": "Я студент.",
          "audioId": "unit3-ex3"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "Я ___ книгу. (читать)",
          "answer": "читаю",
          "audioId": "unit3-q1"
        },
        {
          "type": "fill",
          "q": "Он ___ по-русски. (говорить)",
          "answer": "говорит",
          "audioId": "unit3-q2"
        },
        {
          "type": "mc",
          "q": "Which verb belongs to Conjugation II based on the pattern shown?",
          "options": ["читать", "говорить"],
          "answer": "говорить",
          "audioId": "unit3-q3"
        },
        {
          "type": "mc",
          "q": "In the present tense, Russian usually:",
          "options": ["includes to be like English", "omits to be"],
          "answer": "omits to be",
          "audioId": "unit3-q4"
        },
        {
          "type": "fill",
          "q": "Ты ___ газету. (читать)",
          "answer": "читаешь",
          "audioId": "unit3-q5"
        }
      ]
    },
    {
      "id": "adjective-agreement",
      "title": "Adjective Agreement",
      "icon": "🔗",
      "teaching": [
        {
          "h": "Adjectives agree with their noun",
          "p": "In gender, number, and case.",
