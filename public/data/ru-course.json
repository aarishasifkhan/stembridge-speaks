        },
        {
          "h": "Masculine ending",
          "p": "Typically -ый/-ой.",
          "ex": "новый стол",
          "audioId": "unit4-ex1"
        },
        {
          "h": "Feminine ending",
          "p": "Typically -ая.",
          "ex": "новая книга",
          "audioId": "unit4-ex2"
        },
        {
          "h": "Neuter ending",
          "p": "Typically -ое.",
          "ex": "новое окно",
          "audioId": "unit4-ex3"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "нов___ стол (masculine)",
          "answer": "ый",
          "audioId": "unit4-q1"
        },
        {
          "type": "fill",
          "q": "нов___ книга (feminine)",
          "answer": "ая",
          "audioId": "unit4-q2"
        },
        {
          "type": "fill",
          "q": "нов___ окно (neuter)",
          "answer": "ое",
          "audioId": "unit4-q3"
        },
        {
          "type": "mc",
          "q": "Adjectives in Russian must agree in:",
          "options": ["gender, number, and case", "only gender"],
          "answer": "gender, number, and case",
          "audioId": "unit4-q4"
        },
        {
          "type": "mc",
          "q": "Which ending typically marks a feminine adjective?",
          "options": ["-ая", "-ое", "-ый"],
          "answer": "-ая",
          "audioId": "unit4-q5"
        }
      ]
    },
    {
      "id": "verb-aspect",
      "title": "Verb Aspect",
      "icon": "⏳",
      "teaching": [
        {
          "h": "Two aspects",
          "p": "Almost every Russian verb has an imperfective and perfective partner.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Imperfective",
          "p": "Process, repetition, ongoing action.",
          "ex": "читать (to read, ongoing)",
          "audioId": "unit5-ex1"
        },
        {
          "h": "Perfective",
          "p": "A single, completed action, often with a result.",
          "ex": "прочитать (to read to completion)",
          "audioId": "unit5-ex2"
        },
        {
          "h": "No present tense for perfective",
          "p": "Perfective verbs are used only in past and future.",
          "ex": "",
          "audioId": ""
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Imperfective aspect emphasizes:",
          "options": ["ongoing/repeated action", "a single completed action"],
          "answer": "ongoing/repeated action",
          "audioId": "unit5-q1"
        },
        {
          "type": "mc",
          "q": "Perfective aspect emphasizes:",
          "options": ["ongoing/repeated action", "a single completed action"],
          "answer": "a single completed action",
          "audioId": "unit5-q2"
        },
        {
          "type": "mc",
          "q": "прочитать compared to читать is:",
          "options": ["perfective", "imperfective"],
          "answer": "perfective",
          "audioId": "unit5-q3"
        },
        {
          "type": "mc",
          "q": "Perfective verbs can be used in:",
          "options": ["past and future only", "present tense"],
          "answer": "past and future only",
          "audioId": "unit5-q4"
        },
        {
          "type": "fill",
          "q": "читать is the ___ form.",
          "answer": "imperfective",
          "audioId": "unit5-q5"
        }
      ]
    },
    {
      "id": "parts-of-speech",
      "title": "Части речи (Parts of Speech)",
      "icon": "🧱",
      "teaching": [
        {
          "h": "Main word classes",
          "p": "существительное (noun), глагол (verb), прилагательное (adjective), наречие (adverb), предлог (preposition), союз (conjunction).",
          "ex": "бежать (глагол), быстро (наречие), учитель (существительное)",
          "audioId": "unit6-ex1"
        },
        {
          "h": "Nouns decline by case",
          "p": "Unlike adjectives (which agree with nouns), all nouns themselves change ending based on their case in the sentence.",
          "ex": "стол → стола → столу (nominative → genitive → dative)",
          "audioId": "unit6-ex2"
        },
        {
          "h": "Adverbs are usually invariable",
          "p": "Unlike adjectives, adverbs don't change form for gender/number/case.",
          "ex": "быстро (quickly) — always the same form",
          "audioId": "unit6-ex3"
        },
        {
          "h": "Prepositions govern specific cases",
          "p": "Each preposition requires a specific case for the noun that follows it.",
          "ex": "в доме (в + prepositional case)",
          "audioId": "unit6-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "In \"Он бежит быстро,\" what part of speech is \"быстро\"?",
          "options": ["существительное", "глагол", "наречие"],
          "answer": "наречие",
          "audioId": "unit6-q1"
        },
        {
          "type": "mc",
          "q": "Do Russian nouns change form based on case?",
          "options": ["Yes", "No"],
          "answer": "Yes",
          "audioId": "unit6-q2"
        },
        {
          "type": "mc",
          "q": "Do Russian adverbs typically change form?",
          "options": ["Yes, like adjectives", "No, they're usually invariable"],
          "answer": "No, they're usually invariable",
          "audioId": "unit6-q3"
        },
        {
          "type": "fill",
          "q": "в дом___ (prepositional case ending for \"дом\")",
          "answer": "е",
          "audioId": "unit6-q4"
        },
        {
          "type": "mc",
          "q": "Each preposition in Russian:",
          "options": ["requires a specific case", "works with any case"],
          "answer": "requires a specific case",
          "audioId": "unit6-q5"
        }
      ]
    },
    {
      "id": "sentence-types",
      "title": "Виды предложений (Sentence Types)",
      "icon": "🏗️",
      "teaching": [
        {
          "h": "Повествовательное (statement)",
          "p": "A simple declarative sentence.",
          "ex": "Я люблю кошек.",
          "audioId": "unit7-ex1"
        },
        {
          "h": "Вопросительное (question)",
          "p": "Formed with question words or just rising intonation in speech.",
          "ex": "Ты любишь кошек?",
          "audioId": "unit7-ex2"
        },
        {
          "h": "Побудительное (command)",
          "p": "Directly instructs someone, often with the imperative verb form.",
          "ex": "Сядь, пожалуйста.",
          "audioId": "unit7-ex3"
        },
        {
          "h": "Сложное предложение (compound/complex sentence)",
          "p": "Two clauses joined by и (and), но (but), потому что (because).",
          "ex": "Я люблю кошек, но у меня есть собака.",
          "audioId": "unit7-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"Я люблю кошек.\" is a:",
          "options": [
            "повествовательное предложение",
            "вопросительное предложение"
          ],
          "answer": "повествовательное предложение",
          "audioId": "unit7-q1"
        },
        {
          "type": "mc",
          "q": "\"Сядь, пожалуйста.\" is an example of a:",
          "options": [
            "побудительное предложение",
            "повествовательное предложение"
          ],
          "answer": "побудительное предложение",
          "audioId": "unit7-q2"
        },
        {
          "type": "fill",
          "q": "Я люблю кошек, ___ у меня есть собака. (but)",
          "answer": "но",
          "audioId": "unit7-q3"
        },
        {
          "type": "mc",
          "q": "In spoken Russian, questions are often signaled by:",
          "options": ["rising intonation", "word order change only"],
          "answer": "rising intonation",
          "audioId": "unit7-q4"
        },
        {
          "type": "mc",
          "q": "потому что means:",
          "options": ["because", "but"],
          "answer": "because",
          "audioId": "unit7-q5"
        }
      ]
    },
    {
      "id": "motion-verbs",
      "title": "Motion Verbs (Глаголы движения)",
      "icon": "🚶",
      "teaching": [
        {
          "h": "Two verbs for \"to go\"",
          "p": "идти (going now, on foot, one direction) vs. ходить (habitual/repeated, on foot).",
          "ex": "Я иду в школу. (right now) vs. Я хожу в школу каждый день. (habitually)",
          "audioId": "unit8-ex1"
        },
        {
          "h": "Going by vehicle",
          "p": "ехать (going now, by vehicle) vs. ездить (habitual, by vehicle).",
          "ex": "Я еду на работу. vs. Я езжу на работу каждый день.",
          "audioId": "unit8-ex2"
        },
        {
          "h": "Unidirectional vs. multidirectional",
          "p": "идти/ехать describe one specific trip; ходить/ездить describe repeated or round trips.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Prefixed motion verbs",
          "p": "Prefixes change the meaning: при- (arrive), у- (leave), пере- (cross).",
          "ex": "прийти (to arrive on foot), уйти (to leave on foot)",
          "audioId": "unit8-ex3"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Which verb describes going somewhere right now, on foot?",
          "options": ["идти", "ходить"],
          "answer": "идти",
          "audioId": "unit8-q1"
        },
        {
          "type": "fill",
          "q": "Я ___ в школу каждый день. (habitual, on foot)",
          "answer": "хожу",
          "audioId": "unit8-q2"
        },
        {
          "type": "mc",
          "q": "ехать is used for motion:",
          "options": ["by vehicle", "on foot"],
          "answer": "by vehicle",
          "audioId": "unit8-q3"
        },
        {
          "type": "fill",
          "q": "Я ___ на работу каждый день. (habitual, by vehicle)",
          "answer": "езжу",
          "audioId": "unit8-q4"
        },
        {
          "type": "mc",
          "q": "прийти means:",
          "options": ["to arrive on foot", "to leave on foot"],
          "answer": "to arrive on foot",
          "audioId": "unit8-q5"
        }
      ]
    },
    {
      "id": "comparatives-superlatives",
      "title": "Comparatives and Superlatives",
      "icon": "⚖️",
      "teaching": [
        {
          "h": "Simple comparative",
          "p": "Often formed by adding -ее/-ей to the adjective stem.",
          "ex": "быстрый → быстрее (faster)",
          "audioId": "unit9-ex1"
        },
        {
          "h": "Comparing with чем",
          "p": "чем (than) introduces the second item being compared.",
          "ex": "Он быстрее, чем я. (He is faster than me.)",
          "answer_hint": "",
          "audioId": "unit9-ex2"
        },
        {
          "h": "Superlative with самый",
          "p": "самый + adjective forms the superlative, agreeing in gender/case with the noun.",
          "ex": "самый быстрый (the fastest)",
          "audioId": "unit9-ex3"
        },
        {
          "h": "Irregular comparatives",
          "p": "Some common adjectives have irregular comparative forms, similar to English good/better.",
          "ex": "хороший → лучше (good → better)",
          "audioId": "unit9-ex4"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "быстрый → быстр___ (comparative ending)",
          "answer": "ее",
          "audioId": "unit9-q1"
        },
        {
          "type": "fill",
          "q": "Он быстрее, ___ я. (than)",
          "answer": "чем",
          "audioId": "unit9-q2"
        },
        {
          "type": "mc",
          "q": "The superlative is formed with:",
          "options": ["самый + adjective", "чем + adjective"],
          "answer": "самый + adjective",
          "audioId": "unit9-q3"
        },
        {
          "type": "fill",
          "q": "хороший → ___ (irregular comparative: better)",
          "answer": "лучше",
          "audioId": "unit9-q4"
        },
        {
          "type": "mc",
          "q": "самый быстрый means:",
          "options": ["the fastest", "faster than"],
          "answer": "the fastest",
          "audioId": "unit9-q5"
        }
      ]
    },
    {
      "id": "conditional-sentences",
      "title": "Условные предложения (Conditional Sentences)",
      "icon": "🔀",
      "teaching": [
        {
          "h": "Real conditions with если",
          "p": "если + present/future — realistic situations.",
          "ex": "Если пойдёт дождь, я останусь дома. (If it rains, I'll stay home.)",
          "audioId": "unit10-ex1"
        },
        {
          "h": "Hypothetical conditions with бы",
          "p": "если бы + past tense form, + бы — for unreal/hypothetical situations. Russian conditional doesn't distinguish present vs. past hypothetical the way English does.",
          "ex": "Если бы у меня было время, я бы поехал. (If I had time, I would go.)",
          "audioId": "unit10-ex2"
        },
        {
          "h": "бы is not tied to a specific tense",
          "p": "The particle бы attaches to a past-tense verb form to signal the conditional mood, regardless of when the hypothetical situation is imagined.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Word order flexibility",
          "p": "бы can move within the clause, but the если...бы structure stays recognizable.",
          "ex": "Я бы поехал, если бы у меня было время.",
          "audioId": "unit10-ex3"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "___ пойдёт дождь, я останусь дома. (if)",
          "answer": "Если",
          "audioId": "unit10-q1"
        },
        {
          "type": "mc",
          "q": "Hypothetical conditions use:",
          "options": ["если бы + past-form verb", "если + future only"],
          "answer": "если бы + past-form verb",
          "audioId": "unit10-q2"
        },
        {
          "type": "fill",
          "q": "Если ___ у меня было время, я бы поехал. (бы)",
          "answer": "бы",
          "audioId": "unit10-q3"
        },
        {
          "type": "mc",
          "q": "Does Russian conditional distinguish present vs. past hypothetical like English does?",
          "options": [
            "Yes, with different structures",
            "No, бы works the same either way"
          ],
          "answer": "No, бы works the same either way",
          "audioId": "unit10-q4"
        },
        {
          "type": "mc",
          "q": "бы attaches to a verb in which form?",
          "options": ["past-tense form", "present-tense form"],
          "answer": "past-tense form",
          "audioId": "unit10-q5"
        }
      ]
    },
    {
      "id": "phrases-clauses",
      "title": "Словосочетания и придаточные (Phrases and Clauses)",
      "icon": "🧩",
      "teaching": [
        {
          "h": "Словосочетание (phrase)",
          "p": "A group of words functioning as a unit, no independent subject-verb pairing.",
          "ex": "новый дом (a new house)",
          "audioId": "unit11-ex1"
        },
        {
          "h": "Придаточное предложение (subordinate clause)",
          "p": "Has its own subject and verb but depends on the main clause.",
          "ex": "..., потому что я устал. (..., because I'm tired.)",
          "audioId": "unit11-ex2"
        },
        {
          "h": "Relative clauses with который",
          "p": "который (who/which) introduces a clause describing a noun, and agrees with it in gender/number.",
          "ex": "Человек, который звонил, — мой учитель.",
          "audioId": "unit11-ex3"
        },
        {
          "h": "Comma rules",
          "p": "Subordinate clauses are always set off by a comma in Russian, unlike English which sometimes omits it.",
          "ex": "Я знаю, что ты устал.",
          "audioId": "unit11-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"новый дом\" is an example of a:",
          "options": ["словосочетание", "придаточное предложение"],
          "answer": "словосочетание",
          "audioId": "unit11-q1"
        },
        {
          "type": "fill",
          "q": "Человек, ___ звонил, — мой учитель. (who/which)",
          "answer": "который",
          "audioId": "unit11-q2"
        },
        {
          "type": "mc",
          "q": "который agrees with the noun it describes in:",
          "options": ["gender and number", "case only"],
          "answer": "gender and number",
          "audioId": "unit11-q3"
        },
