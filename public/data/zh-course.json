    {
      "id": "ba-bei-constructions",
      "title": "把 and 被 Constructions",
      "icon": "🔄",
      "teaching": [
        {
          "h": "The 把 (bǎ) construction",
          "p": "Moves the object before the verb to emphasize what happened to it — common when the object is affected/disposed of.",
          "ex": "我把书放在桌子上。(I put the book on the table.)",
          "audioId": "unit12-ex1"
        },
        {
          "h": "When to use 把",
          "p": "Typically when the action clearly does something specific and definite to the object.",
          "ex": "他把门关了。(He closed the door.)",
          "audioId": "unit12-ex2"
        },
        {
          "h": "The 被 (bèi) construction — passive voice",
          "p": "Subject + 被 + (doer) + verb — the closest equivalent to English passive voice.",
          "ex": "书被他拿走了。(The book was taken by him.)",
          "audioId": "unit12-ex3"
        },
        {
          "h": "被 without a stated doer",
          "p": "The doer can be omitted if unknown or unimportant.",
          "ex": "杯子被打破了。(The cup was broken.)",
          "audioId": "unit12-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "The 把 construction moves the object:",
          "options": ["before the verb", "after the verb"],
          "answer": "before the verb",
          "audioId": "unit12-q1"
        },
        {
          "type": "fill",
          "q": "我___书放在桌子上。(bǎ)",
          "answer": "把",
          "audioId": "unit12-q2"
        },
        {
          "type": "mc",
          "q": "被 (bèi) is closest to English:",
          "options": ["passive voice", "future tense"],
          "answer": "passive voice",
          "audioId": "unit12-q3"
        },
        {
          "type": "fill",
          "q": "书___他拿走了。(bèi)",
          "answer": "被",
          "audioId": "unit12-q4"
        },
        {
          "type": "mc",
          "q": "In a 被 sentence, can the doer be omitted?",
          "options": [
            "Yes, if unknown/unimportant",
            "No, it's always required"
          ],
          "answer": "Yes, if unknown/unimportant",
          "audioId": "unit12-q5"
        }
      ]
    },
    {
      "id": "direct-indirect-speech",
      "title": "Direct and Indirect Speech",
      "icon": "💬",
      "teaching": [
        {
          "h": "Direct speech",
          "p": "The exact words, often marked with quotation marks in writing.",
          "ex": "他说：\"我很累。\" (He said, \"I'm tired.\")",
          "audioId": "unit13-ex1"
        },
        {
          "h": "Indirect speech with 说",
          "p": "他说 + clause, without quotation marks — reports the idea, not the exact words.",
          "ex": "他说他很累。(He said he was tired.)",
          "audioId": "unit13-ex2"
        },
        {
          "h": "No tense shifting needed",
          "p": "Unlike English, Mandarin verbs don't change form when reporting speech — the meaning stays clear from context.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "Pronouns still shift",
          "p": "\"我\" (I) in direct speech often becomes \"他/她\" in reported speech, matching the new perspective.",
          "ex": "\"我很忙\" → 他说他很忙。",
          "audioId": "unit13-ex3"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "他说：\"我很累。\" is:",
          "options": ["direct speech", "indirect speech"],
          "answer": "direct speech",
          "audioId": "unit13-q1"
        },
        {
          "type": "fill",
          "q": "他说___很累。(he — reported)",
          "answer": "他",
          "audioId": "unit13-q2"
        },
        {
          "type": "mc",
          "q": "Does the verb change form in Mandarin reported speech?",
          "options": ["Yes, like English", "No"],
          "answer": "No",
          "audioId": "unit13-q3"
        },
        {
          "type": "mc",
          "q": "\"我很忙\" reported becomes:",
          "options": ["他说他很忙。", "他说我很忙。"],
          "answer": "他说他很忙。",
          "audioId": "unit13-q4"
        },
        {
          "type": "mc",
          "q": "Indirect speech in Mandarin uses:",
          "options": [
            "no quotation marks, pronoun shift",
            "quotation marks around the exact words"
          ],
          "answer": "no quotation marks, pronoun shift",
          "audioId": "unit13-q5"
        }
      ]
    },
