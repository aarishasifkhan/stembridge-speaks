{
  "units": [
    {
      "id": "word-order",
      "title": "Word Order (SVO)",
      "icon": "📘",
      "teaching": [
        {
          "h": "Basic word order",
          "p": "Mandarin follows Subject-Verb-Object, and verbs never change form for tense or subject.",
          "ex": "我喝茶 (wǒ hē chá) — I drink tea",
          "audioId": "unit1-ex1"
        },
        {
          "h": "No verb conjugation",
          "p": "The verb stays the same no matter who's doing it or when.",
          "ex": "他喝茶 (tā hē chá) — he drinks tea",
          "audioId": "unit1-ex2"
        },
        {
          "h": "Time words come early",
          "p": "Time expressions usually come right after the subject.",
          "ex": "我今天喝茶 (wǒ jīntiān hē chá)",
          "audioId": "unit1-ex3"
        },
        {
          "h": "No plural verb forms",
          "p": "Nouns and verbs don't change for singular/plural.",
          "ex": "一个人 / 两个人 (yí gè rén / liǎng gè rén)",
          "audioId": "unit1-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Mandarin sentence order is generally:",
          "options": ["SVO", "SOV", "VSO"],
          "answer": "SVO",
          "audioId": "unit1-q1"
        },
        {
          "type": "fill",
          "q": "我 ___ 茶。(I drink tea)",
          "answer": "喝",
          "audioId": "unit1-q2"
        },
        {
          "type": "mc",
          "q": "How does Mandarin show verb tense?",
          "options": ["verb conjugation", "other words like time expressions"],
          "answer": "other words like time expressions",
          "audioId": "unit1-q3"
        },
        {
          "type": "mc",
          "q": "Where do time words usually go?",
          "options": ["right after the subject", "always at the very end"],
          "answer": "right after the subject",
          "audioId": "unit1-q4"
        },
        {
          "type": "fill",
          "q": "他 ___ 茶。(he drinks tea)",
          "answer": "喝",
          "audioId": "unit1-q5"
        }
      ]
    },
    {
      "id": "measure-words",
      "title": "Measure Words (量词)",
      "icon": "🔢",
      "teaching": [
        {
          "h": "What measure words do",
          "p": "Between a number and a noun, Mandarin requires a measure word.",
          "ex": "一个人 (yí gè rén)",
          "audioId": "unit2-ex1"
        },
        {
          "h": "个 (gè) — the general measure word",
          "p": "Used for people and many general objects.",
          "ex": "三个苹果 (sān gè píngguǒ)",
          "audioId": "unit2-ex2"
        },
        {
          "h": "本 (běn) for books",
          "p": "Used specifically for bound, book-like objects.",
          "ex": "两本书 (liǎng běn shū)",
          "audioId": "unit2-ex3"
        },
        {
          "h": "杯 (bēi) for cups/glasses",
          "p": "Used for drinks measured by cup.",
          "ex": "一杯茶 (yì bēi chá)",
          "audioId": "unit2-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "Measure words go between:",
          "options": ["a number and a noun", "a verb and a noun"],
          "answer": "a number and a noun",
          "audioId": "unit2-q1"
        },
        {
          "type": "fill",
          "q": "三___苹果 (general measure word)",
          "answer": "个",
          "audioId": "unit2-q2"
        },
        {
          "type": "mc",
          "q": "Which measure word is for books?",
          "options": ["个", "本", "杯"],
          "answer": "本",
          "audioId": "unit2-q3"
        },
        {
          "type": "fill",
          "q": "一___茶 (cup)",
          "answer": "杯",
          "audioId": "unit2-q4"
        },
        {
          "type": "mc",
          "q": "个 (gè) is best described as:",
          "options": ["the general/default measure word", "only for books"],
          "answer": "the general/default measure word",
          "audioId": "unit2-q5"
        }
      ]
    },
    {
      "id": "key-particles",
      "title": "Key Particles: 了 的 吗",
      "icon": "🧩",
      "teaching": [
        {
          "h": "了 (le) marks completed action",
          "p": "Shows something happened or changed.",
          "ex": "我吃了 (wǒ chī le)",
          "audioId": "unit3-ex1"
        },
        {
          "h": "的 (de) shows possession",
          "p": "Placed between the owner and the thing owned.",
          "ex": "我的书 (wǒ de shū)",
          "audioId": "unit3-ex2"
        },
        {
          "h": "吗 (ma) forms yes/no questions",
          "p": "Added at the very end of a sentence.",
          "ex": "你喝茶吗？ (nǐ hē chá ma?)",
          "audioId": "unit3-ex3"
        },
        {
          "h": "Grammatical markers, not standalone words",
          "p": "These particles don't translate word-for-word into English.",
          "ex": "",
          "audioId": ""
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "了 (le) is used to show:",
          "options": ["completed action", "possession"],
          "answer": "completed action",
          "audioId": "unit3-q1"
        },
        {
          "type": "fill",
          "q": "我___书 (my book)",
          "answer": "的",
          "audioId": "unit3-q2"
        },
        {
          "type": "mc",
          "q": "吗 (ma) is placed:",
          "options": ["at the end of a sentence", "at the beginning"],
          "answer": "at the end of a sentence",
          "audioId": "unit3-q3"
        },
        {
          "type": "fill",
          "q": "你喝茶___？(yes/no question)",
          "answer": "吗",
          "audioId": "unit3-q4"
        },
        {
          "type": "mc",
          "q": "的 (de) functions like:",
          "options": ["possessive 's in English", "a question mark"],
          "answer": "possessive 's in English",
          "audioId": "unit3-q5"
        }
      ]
    },
    {
      "id": "forming-questions",
      "title": "Forming Questions",
      "icon": "❓",
      "teaching": [
        {
          "h": "Yes/no questions with 吗",
          "p": "Add 吗 to the end of a normal statement — no word order change.",
          "ex": "你是学生吗？ (nǐ shì xuéshēng ma?)",
          "audioId": "unit4-ex1"
        },
        {
          "h": "Choice questions with 还是",
          "p": "Present two options connected by 还是 (háishì, \"or\").",
          "ex": "你要茶还是咖啡？ (nǐ yào chá háishì kāfēi?)",
          "audioId": "unit4-ex2"
        },
        {
          "h": "Question words stay in place",
          "p": "Words like 什么 (shénme, \"what\") stay where the answer would go.",
          "ex": "你要什么？ (nǐ yào shénme?)",
          "audioId": "unit4-ex3"
        },
        {
          "h": "A-not-A questions",
          "p": "Repeating the verb with 不 (bù) in between also forms a yes/no question.",
          "ex": "你要不要茶？ (nǐ yào bú yào chá?)",
          "audioId": "unit4-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "The simplest way to form a yes/no question is:",
          "options": ["add 吗 to the end", "move the verb to the front"],
          "answer": "add 吗 to the end",
          "audioId": "unit4-q1"
        },
        {
          "type": "fill",
          "q": "你要茶___咖啡？(or)",
          "answer": "还是",
          "audioId": "unit4-q2"
        },
        {
          "type": "mc",
          "q": "Where does 什么 (what) go in a Mandarin question?",
          "options": ["where the answer would be", "always at the very front"],
          "answer": "where the answer would be",
          "audioId": "unit4-q3"
        },
        {
          "type": "fill",
          "q": "你要___要茶？(A-not-A)",
          "answer": "不",
          "audioId": "unit4-q4"
        },
        {
          "type": "mc",
          "q": "还是 (háishì) is used for:",
          "options": ["choice questions", "yes/no questions with 吗"],
          "answer": "choice questions",
          "audioId": "unit4-q5"
        }
      ]
    },
    {
      "id": "time-aspect",
      "title": "Time & Aspect (了 过 在)",
      "icon": "⏳",
      "teaching": [
        {
          "h": "了 (le) for completed/change",
          "p": "Marks a completed action or a new state.",
          "ex": "我到了 (wǒ dào le)",
          "audioId": "unit5-ex1"
        },
        {
          "h": "过 (guo) for past experience",
          "p": "Indicates something has been experienced at least once, ever.",
          "ex": "我去过中国 (wǒ qùguo Zhōngguó)",
          "audioId": "unit5-ex2"
        },
        {
          "h": "在 (zài) for ongoing action",
          "p": "Placed before the verb to show an action is currently in progress.",
          "ex": "我在吃饭 (wǒ zài chīfàn)",
          "audioId": "unit5-ex3"
        },
        {
          "h": "Aspect, not strict tense",
          "p": "Mandarin marks how an action relates to time, not when exactly it happened.",
          "ex": "",
          "audioId": ""
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "过 (guo) indicates:",
          "options": ["past experience ever", "action happening right now"],
          "answer": "past experience ever",
          "audioId": "unit5-q1"
        },
        {
          "type": "fill",
          "q": "我___吃饭。(I am eating)",
          "answer": "在",
          "audioId": "unit5-q2"
        },
        {
          "type": "mc",
          "q": "在 (zài) goes:",
          "options": ["before the verb", "after the verb"],
          "answer": "before the verb",
          "audioId": "unit5-q3"
        },
        {
          "type": "fill",
          "q": "我去___中国。(I've been to China)",
          "answer": "过",
          "audioId": "unit5-q4"
        },
        {
          "type": "mc",
          "q": "Mandarin grammatically marks:",
          "options": [
            "aspect (how action relates to time)",
            "strict tense like English"
          ],
          "answer": "aspect (how action relates to time)",
          "audioId": "unit5-q5"
        }
      ]
    },
    {
      "id": "parts-of-speech",
      "title": "Parts of Speech (词类)",
      "icon": "🧱",
      "teaching": [
        {
          "h": "Main word classes",
          "p": "名词 (noun), 动词 (verb), 形容词 (adjective), 副词 (adverb), 介词 (preposition), 连词 (conjunction).",
          "ex": "跑 (dòngcí/verb), 快 (fùcí/adverb), 老师 (míngcí/noun)",
          "audioId": "unit6-ex1"
        },
        {
          "h": "形容词 (adjectives) can act as verbs",
          "p": "Many Chinese adjectives function like stative verbs and don't need 是 (to be) before them.",
          "ex": "她很高。(She is tall.) — no 是 needed",
          "audioId": "unit6-ex2"
        },
        {
          "h": "副词 (adverbs) come before the verb",
          "p": "Unlike English, adverbs are placed before, not after, the verb they modify.",
          "ex": "他很快跑。(He runs quickly.)",
          "audioId": "unit6-ex3"
        },
        {
          "h": "介词 (prepositions) form phrases before the verb",
          "p": "Prepositional phrases usually come before the verb, not after like in English.",
          "ex": "我在家吃饭。(I eat at home.)",
          "audioId": "unit6-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "In \"她很高,\" what part of speech is \"高\"?",
          "options": ["名词 (noun)", "形容词 (adjective)", "副词 (adverb)"],
          "answer": "形容词 (adjective)",
          "audioId": "unit6-q1"
        },
        {
          "type": "mc",
          "q": "Chinese adjectives like 高 (tall) typically:",
          "options": [
            "need 是 before them",
            "act like stative verbs, no 是 needed"
          ],
          "answer": "act like stative verbs, no 是 needed",
          "audioId": "unit6-q2"
        },
        {
          "type": "mc",
          "q": "In Mandarin, adverbs are placed:",
          "options": ["before the verb", "after the verb"],
          "answer": "before the verb",
          "audioId": "unit6-q3"
        },
        {
          "type": "fill",
          "q": "他___跑。(quickly — fùcí before verb)",
          "answer": "快",
          "audioId": "unit6-q4"
        },
        {
          "type": "mc",
          "q": "介词 phrases (like 在家) usually go:",
          "options": ["before the verb", "after the verb"],
          "answer": "before the verb",
          "audioId": "unit6-q5"
        }
      ]
    },
    {
      "id": "sentence-types",
      "title": "Sentence Types",
      "icon": "🏗️",
      "teaching": [
        {
          "h": "陈述句 (statement)",
          "p": "A simple declarative sentence, following SVO order.",
          "ex": "我喜欢猫。(I like cats.)",
          "audioId": "unit7-ex1"
        },
        {
          "h": "疑问句 (question)",
          "p": "Formed with 吗, a question word, or A-not-A structure.",
          "ex": "你喜欢猫吗？",
          "audioId": "unit7-ex2"
        },
        {
          "h": "祈使句 (command)",
          "p": "Directly instructs someone, often with 请 (please) for politeness.",
          "ex": "请坐。(Please sit.)",
          "audioId": "unit7-ex3"
        },
        {
          "h": "并列句 (compound sentence)",
          "p": "Two clauses joined by connectors like 和 (and) or 但是 (but).",
          "ex": "我喜欢猫，但是我更喜欢狗。",
          "audioId": "unit7-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"我喜欢猫。\" is a(n):",
          "options": ["陈述句", "疑问句"],
          "answer": "陈述句",
          "audioId": "unit7-q1"
        },
        {
          "type": "mc",
          "q": "\"请坐。\" is an example of a:",
          "options": ["祈使句", "陈述句"],
          "answer": "祈使句",
          "audioId": "unit7-q2"
        },
        {
          "type": "fill",
          "q": "我喜欢猫，___我更喜欢狗。(but)",
          "answer": "但是",
          "audioId": "unit7-q3"
        },
        {
          "type": "mc",
          "q": "请 (qǐng) is used to make a sentence:",
          "options": ["more polite", "more negative"],
          "answer": "more polite",
          "audioId": "unit7-q4"
        },
        {
          "type": "mc",
          "q": "A 并列句 joins two clauses using:",
          "options": ["connectors like 和/但是", "no connector at all"],
          "answer": "connectors like 和/但是",
          "audioId": "unit7-q5"
        }
      ]
    },
    {
      "id": "complements",
      "title": "Complements (补语)",
      "icon": "🤝",
      "teaching": [
        {
          "h": "Result complements (结果补语)",
          "p": "A second verb/adjective right after the main verb shows the result of the action.",
          "ex": "我听懂了。(I heard and understood.)",
          "audioId": "unit8-ex1"
        },
        {
          "h": "Directional complements (趋向补语)",
          "p": "Words like 来/去 after a verb show the direction of movement.",
          "ex": "他走进来了。(He walked in.)",
          "audioId": "unit8-ex2"
        },
        {
          "h": "Degree complements (程度补语)",
          "p": "得 + adjective after a verb describes how well/much an action is done.",
          "ex": "她说得很好。(She speaks very well.)",
          "audioId": "unit8-ex3"
        },
        {
          "h": "Potential complements",
          "p": "得/不 inserted between verb and complement shows possibility or impossibility.",
          "ex": "我听得懂。(I can understand.) 我听不懂。(I can't understand.)",
          "audioId": "unit8-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"我听懂了\" uses a:",
          "options": ["result complement", "directional complement"],
          "answer": "result complement",
          "audioId": "unit8-q1"
        },
        {
          "type": "fill",
          "q": "他走进___了。(direction: come)",
          "answer": "来",
          "audioId": "unit8-q2"
        },
        {
          "type": "mc",
          "q": "得 + adjective after a verb is a:",
          "options": ["degree complement", "result complement"],
          "answer": "degree complement",
          "audioId": "unit8-q3"
        },
        {
          "type": "fill",
          "q": "我听___懂。(potential: can understand)",
          "answer": "得",
          "audioId": "unit8-q4"
        },
        {
          "type": "mc",
          "q": "我听不懂 means:",
          "options": ["I can't understand", "I didn't listen"],
          "answer": "I can't understand",
          "audioId": "unit8-q5"
        }
      ]
    },
    {
      "id": "comparisons",
      "title": "Comparisons (比较句)",
      "icon": "⚖️",
      "teaching": [
        {
          "h": "比 (bǐ) for comparison",
          "p": "A + 比 + B + adjective compares two things directly.",
          "ex": "他比我高。(He is taller than me.)",
          "audioId": "unit9-ex1"
        },
        {
          "h": "跟...一样 for equality",
          "p": "Shows two things are the same in some way.",
          "ex": "我跟他一样高。(I'm as tall as him.)",
          "audioId": "unit9-ex2"
        },
        {
          "h": "没有...那么 for inequality",
          "p": "Shows one thing is less than another.",
          "ex": "我没有他那么高。(I'm not as tall as him.)",
          "audioId": "unit9-ex3"
        },
        {
          "h": "最 for superlatives",
          "p": "最 before an adjective means \"the most.\"",
          "ex": "他最高。(He is the tallest.)",
          "audioId": "unit9-ex4"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "他___我高。(comparison word: bǐ)",
          "answer": "比",
          "audioId": "unit9-q1"
        },
        {
          "type": "mc",
          "q": "跟...一样 expresses:",
          "options": ["equality", "the superlative"],
          "answer": "equality",
          "audioId": "unit9-q2"
        },
        {
          "type": "fill",
          "q": "我没有他___高。(that/so — nàme)",
          "answer": "那么",
          "audioId": "unit9-q3"
        },
        {
          "type": "mc",
          "q": "最 (zuì) means:",
          "options": ["the most", "as...as"],
          "answer": "the most",
          "audioId": "unit9-q4"
        },
        {
          "type": "mc",
          "q": "\"他比我高\" means:",
          "options": ["He is taller than me", "He is as tall as me"],
          "answer": "He is taller than me",
          "audioId": "unit9-q5"
        }
      ]
    },
    {
      "id": "conditional-sentences",
      "title": "Conditional Sentences",
      "icon": "🔀",
      "teaching": [
        {
          "h": "如果...就 (if...then)",
          "p": "The most common way to express a real or hypothetical condition.",
          "ex": "如果下雨，我就不去。(If it rains, I won't go.)",
          "audioId": "unit10-ex1"
        },
        {
          "h": "要是...的话",
          "p": "A more conversational way to say \"if,\" often used in spoken Mandarin.",
          "ex": "要是你有时间的话，来吧。(If you have time, come.)",
          "audioId": "unit10-ex2"
        },
        {
          "h": "No verb tense changes",
          "p": "Unlike English/Spanish, Mandarin conditionals don't change verb forms — context and time words carry the meaning.",
          "ex": "",
          "audioId": ""
        },
        {
          "h": "只要...就 (as long as...then)",
          "p": "Expresses a sufficient condition.",
          "ex": "只要你努力，就会成功。(As long as you try hard, you'll succeed.)",
          "audioId": "unit10-ex3"
        }
      ],
      "quiz": [
        {
          "type": "fill",
          "q": "如果下雨，我___不去。(then)",
          "answer": "就",
          "audioId": "unit10-q1"
        },
        {
          "type": "mc",
          "q": "要是...的话 is:",
          "options": [
            "a more conversational way to say \"if\"",
            "only used in formal writing"
          ],
          "answer": "a more conversational way to say \"if\"",
          "audioId": "unit10-q2"
        },
        {
          "type": "mc",
          "q": "Do Mandarin conditional verbs change tense/form like in English?",
          "options": ["Yes", "No"],
          "answer": "No",
          "audioId": "unit10-q3"
        },
        {
          "type": "fill",
          "q": "只要你努力，___会成功。(then)",
          "answer": "就",
          "audioId": "unit10-q4"
        },
        {
          "type": "mc",
          "q": "只要...就 expresses:",
          "options": ["a sufficient condition", "an impossible condition"],
          "answer": "a sufficient condition",
          "audioId": "unit10-q5"
        }
      ]
    },
    {
      "id": "phrases-clauses",
      "title": "Phrases and Clauses (短语和从句)",
      "icon": "🧩",
      "teaching": [
        {
          "h": "短语 (phrase)",
          "p": "A group of words functioning as one unit, no complete subject-verb pairing needed.",
          "ex": "在家里 (at home), 很高兴 (very happy)",
          "audioId": "unit11-ex1"
        },
        {
          "h": "从句 (clause)",
          "p": "Has its own subject and verb.",
          "ex": "他说的话 (what he said)",
          "audioId": "unit11-ex2"
        },
        {
          "h": "的-clauses as modifiers",
          "p": "的 turns a clause into a description attached to a noun, similar to a relative clause.",
          "ex": "我昨天买的书 (the book I bought yesterday)",
          "audioId": "unit11-ex3"
        },
        {
          "h": "Connecting clauses",
          "p": "Words like 因为...所以 (because...so) and 虽然...但是 (although...but) link clauses together.",
          "ex": "因为下雨，所以我没去。",
          "audioId": "unit11-ex4"
        }
      ],
      "quiz": [
        {
          "type": "mc",
          "q": "\"在家里\" is an example of a:",
          "options": ["短语", "从句"],
          "answer": "短语",
          "audioId": "unit11-q1"
        },
        {
